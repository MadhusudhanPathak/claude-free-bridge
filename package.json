{
  "name": "claude-free-bridge",
  "version": "1.0.0",
  "description": "Use your claude.ai account from local apps through an OpenAI/Anthropic-compatible API, via a Chromium browser extension and a small desktop app.",
  "license": "MIT",
  "author": "Madhusudhan Pathak",
  "homepage": "https://github.com/MadhusudhanPathak/claude-free-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadhusudhanPathak/claude-free-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/MadhusudhanPathak/claude-free-bridge/issues"
  },
  "keywords": [
    "claude",
    "claude.ai",
    "anthropic",
    "openai-compatible",
    "browser-extension",
    "edge",
    "brave",
    "chrome"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "claude-free-bridge": "packages/helper/dist/cli.js"
  },
  "files": [
    "packages/helper/dist/cli.js",
    "packages/helper/dist/server.js",
    "packages/extension/dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node packages/helper/dist/cli.js",
    "typecheck": "tsc -p tsconfig.helper.json && tsc -p tsconfig.extension.json && tsc -p tsconfig.ui.json",
    "test": "npm run build && node --test \"packages/*/test/*.test.mjs\"",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "typescript": "^5.5.0",
    "ws": "^8.22.0"
  }
}
