{
  "manifest_version": 3,
  "name": "Claude Free Bridge",
  "version": "1.0.0",
  "description": "Use your logged-in claude.ai session from local tools and coding agents, through the Claude Free Bridge app.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "sidePanel", "alarms", "cookies"],
  "host_permissions": ["https://claude.ai/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Claude Free Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
